{
    "manifest_version": 3,
    "name": "QA AI Assistant",
    "version": "1.0.0",
    "description": "AI-powered test generation and quality analysis",
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "https://api.openai.com/*",
        "https://*.atlassian.net/*",
        "https://*.testrail.io/*",
        "https://api.github.com/*",
        "https://generativelanguage.googleapis.com/*",
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Generate Test Cases",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icon*.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}