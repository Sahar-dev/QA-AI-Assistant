{
    "manifest_version": 3,
    "name": "QA AI Assistant",
    "version": "2.0.0",
    "description": "AI-powered test generation and quality analysis in a persistent sidebar",
    "permissions": [
        "sidePanel",
        "activeTab",
        "storage",
        "scripting",
        "tabs",
        "webNavigation",
        "identity",
        "background",
        "contextMenus",
        "notifications",
        "webRequest"
    ],
    "host_permissions": [
        "https://api.openai.com/*",
        "https://*.atlassian.net/*",
        "https://*.testrail.io/*",
        "https://api.github.com/*",
        "https://generativelanguage.googleapis.com/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "action": {
        "default_title": "QA AI Assistant",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "side_panel": {
        "default_path": "sidebar.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "recording/recorder.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icon*.png",
                "sidebar.html",
                "sidebar.js",
                "replay-viewer.js",
                "timeline-view.js",
                "recording/recorder-injected.js",
                "ui/*",
                "core/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}